            "type": "command",
            "command": "powershell.exe -NoProfile -Command \"$d=[Console]::In.ReadToEnd()|ConvertFrom-Json; $t='Task complete'; try{ $L=Get-Content $d.transcript_path; for($i=$L.Count-1;$i -ge 0;$i--){ $e=$L[$i]|ConvertFrom-Json; if($e.message.role -eq 'assistant'){ $c=$e.message.content; $x=if($c -is [string]){$c}else{($c|Where-Object{$_.type -eq 'text'}|Select-Object -Last 1).text}; if($x){ $x=$x.Trim(); if($x.Length -gt 0){ if($x.EndsWith('?')){$t='Claude has a question'}; break } } } } }catch{}; Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.MessageBox]::Show($t,'Claude Code')|Out-Null\""
          }
        ]
      }
