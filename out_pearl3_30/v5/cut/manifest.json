{
  "material": "clear cast acrylic (perspex)",
  "process": "raster engrave for tone, vector through-cut for outline and slots",
  "machine_order": [
    "ENG_L",
    "ENG_D",
    "ENG_K",
    "CUT_SLOT",
    "CUT_OUTLINE"
  ],
  "order_rationale": "engrave while the sheet is still a rigid rectangle; cutting the slots first leaves a floppy carrier that lifts and defocuses",
